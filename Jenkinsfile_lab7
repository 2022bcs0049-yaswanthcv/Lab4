pipeline {
    agent any

    environment {
        IMAGE = "yash450987/yaswanth_2022bcs0049_lab4:latest"
        CONTAINER = "lab7_test_container"
        HOST_IP = "172.17.0.1"
    }

    stages {

        stage('Pull Image') {
            steps {
                sh 'docker pull $IMAGE'
            }
        }

        stage('Run Container') {
            steps {
                sh '''
                echo "Removing old container if exists..."
                docker rm -f $CONTAINER || true

                echo "Starting container on port 8001..."
                docker run -d --name $CONTAINER -p 8001:8000 $IMAGE

                echo "Waiting for API to start..."

                for i in {1..20}
                do
                    sleep 3
                    if curl -s http://$HOST_IP:8001/docs > /dev/null; then
                        echo "API is ready"
                        exit 0
                    fi
                    echo "Waiting..."
                done

                echo "API failed to start"
                docker logs $CONTAINER
                exit 1
                '''
            }
        }

        stage('Test Valid Request') {
            steps {
                sh '''
                echo "Sending valid request..."

                curl -X POST "http://$HOST_IP:8001/predict" \
                -H "Content-Type: application/json" \
                -d '{
                    "fixed_acidity": 7,
                    "volatile_acidity": 0.3,
                    "citric_acid": 0.4,
                    "residual_sugar": 6,
                    "chlorides": 0.05,
                    "free_sulfur_dioxide": 30,
                    "total_sulfur_dioxide": 120,
                    "density": 0.995,
                    "pH": 3.3,
                    "sulphates": 0.6,
                    "alcohol": 10
                }'
                '''
            }
        }

        stage('Test Invalid Request') {
            steps {
                sh '''
                echo "Sending invalid request..."

                curl -X POST "http://$HOST_IP:8001/predict" \
                -H "Content-Type: application/json" \
                -d '{"wrong_field": 123}' || true
                '''
            }
        }

        stage('Stop Container') {
            steps {
                sh '''
                echo "Stopping container..."
                docker rm -f $CONTAINER || true
                '''
            }
        }
    }
}